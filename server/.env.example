# MongoDB Atlas connection string (from Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chromatic-invoice?retryWrites=true&w=majority

# Must match ADMIN_PASSWORD in the frontend's src/config/authConfig.ts
ADMIN_API_KEY=chromatic2026

# Your deployed frontend URL, e.g. https://chromatic-invoice.vercel.app
# Use * only while testing locally.
ALLOWED_ORIGIN=*

PORT=4000
